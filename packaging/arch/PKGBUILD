# Maintainer: happyarch
pkgname=nixalarm
pkgver=0.2.1
pkgrel=1
pkgdesc='Small Linux alarm clock with seven-segment, nixie, analog, and sundial displays and file, stream, and optional SDR audio sources'
arch=('x86_64' 'aarch64' 'armv7h' 'riscv64' 'loong64')
url='https://github.com/Happyarch/nixalarm'
license=('GPL-3.0-or-later')
# librsvg renders the analog face's SVG dial; libepoxy loads the GL entry
# points for the raytraced sundial/moondial faces.
depends=('sdl2' 'ffmpeg' 'fluidsynth' 'librsvg' 'libepoxy' 'gcc-libs' 'glibc')
makedepends=('cmake' 'gcc' 'pkgconf')
optdepends=('rtl-sdr: RTL-SDR alarm sources -- weather band, broadcast FM, AM -- via rtl_fm')
source=()
sha256sums=()

build() {
  cmake -S "$startdir/../.." -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-author
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  install -Dm644 "$startdir/../../README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$startdir/../../AGENTS.md" \
    "$pkgdir/usr/share/doc/$pkgname/AGENTS.md"
}
